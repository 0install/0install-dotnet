{
  "metadata": [
    {
      "src": [
        {
          "src": "../artifacts/Release/net10.0",
          "files": ["ZeroInstall.*.dll", "0install.dll"],
          "exclude": ["*.XmlSerializers.dll"]
        }
      ],
      "references": [
        {
          "src": "../artifacts/Release/net10.0/runtimes/linux-x64/lib/netstandard2.0",
          "files": ["Tmds.LibC.dll"]
        }
      ],
      "namespaceLayout": "nested",
      "dest": "api",
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "globalMetadata": {
      "_baseUrl": "https://dotnet.0install.net/",
      "_appTitle": "Zero Install .NET API",
      "_appFooter": "Copyright Bastian Eicher et al"
    },
    "content": [
      {
        "files": [
          "*.md",
          "toc.yml",
          "docs/toc.yml",
          "api/*.yml"
        ]
      }
    ],
    "resource": [
      {
        "src": "..",
        "files": ["logo.svg"]
      }
    ],
    "overwrite": [
      {
        "src": "../src/",
        "files": ["**/*.md"]
      }
    ],
    "xref": [
      "https://common.nano-byte.net/xrefmap.yml"
    ],
    "xrefService": [
      "https://xref.docs.microsoft.com/query?uid={uid}"
    ],
    "postProcessors": ["ExtractSearchIndex"],
    "template": [
      "default",
      "modern",
      "template"
    ],
    "dest": "../artifacts/Documentation"
  }
}
